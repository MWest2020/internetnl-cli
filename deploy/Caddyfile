# Edge proxy for the netnl facade. Caddy obtains and renews TLS
# automatically for the hostname in NETNL_PUBLIC_HOST (set via .env; see
# deploy/.env.example). No hostname is hardcoded here — the endpoint is
# configuration, same rule as the facade's own upstream endpoint.

{$NETNL_PUBLIC_HOST} {
	# HSTS belongs to whichever hop terminates TLS — that is Caddy in this
	# topology, not the netnl process behind it (which may itself be
	# reached over plain HTTP on the internal docker network, and so never
	# sets this header itself; see src/netnl/api.py's security_headers).
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy netnl:8000
}
