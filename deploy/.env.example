# Copy this file to deploy/.env and fill in real values. deploy/.env is
# gitignored — the upstream credential must never enter the repository.
#
# See openspec/changes/add-measurement-api/design.md, "Configuration", for
# the full meaning of each variable, and docs/how-to/deploy-facade.md for
# the deploy runbook.

# --- Edge (Caddy) ---------------------------------------------------------

# Public hostname this facade is reachable at. Caddy requests a TLS
# certificate for exactly this name; DNS must already point here.
NETNL_PUBLIC_HOST=facade.example.org

# Name of the docker network the upstream batch instance's own compose
# stack created for itself (e.g. `<instance-project>_default`). The
# instance must not publish a public port on it — this facade is the only
# public path to it. Discover it with `docker network ls` on the instance
# host.
NETNL_UPSTREAM_NETWORK=<instance-internal-network-name>

# --- Upstream (private batch instance) ------------------------------------

# Base URL of the batch instance's v2 API, reachable over
# NETNL_UPSTREAM_NETWORK — not a public address.
NETNL_UPSTREAM_ENDPOINT=https://<instance-intern>/api/batch/v2

# Batch credential issued on the upstream instance (see
# docs/reference/self-hosted.md). Server-side only; never exposed to
# tenants of this facade.
NETNL_UPSTREAM_USERNAME=<vul in>
NETNL_UPSTREAM_PASSWORD=<vul in>

# Set to 1 only if the internal hop to the upstream instance is plain HTTP
# (e.g. an isolated docker network you trust). Leave unset for https.
# NETNL_ALLOW_HTTP=1

# --- Facade storage ---------------------------------------------------------

# SQLite path inside the container. compose.yaml already sets this to the
# mounted volume path (/data/netnl.sqlite3) — no need to repeat it here
# unless overriding compose.yaml.
# NETNL_DB=/data/netnl.sqlite3

# --- Tunables (defaults shown as comments; uncomment to override) ---------

# Provenance name sent as the X-Netnl-Instance header on every reply.
# NETNL_INSTANCE=netnl

# Submissions per credential per hour.
# NETNL_RATE_LIMIT=10

# Max domains accepted per request.
# NETNL_MAX_DOMAINS=500

# Max non-terminal (in-progress) runs per credential at once.
# NETNL_MAX_CONCURRENT=2

# Days a finished request stays retrievable before `prune` removes it.
# NETNL_RESULT_RETENTION_DAYS=7

# Days audit records are kept before `prune` removes them.
# NETNL_AUDIT_RETENTION_DAYS=90

# Seconds the metadata/report passthrough is cached.
# NETNL_METADATA_TTL=3600

# Upstream HTTP timeout, seconds.
# NETNL_TIMEOUT=30

# Per-domain length cap (DNS hostname length limit).
# NETNL_MAX_DOMAIN_LENGTH=253

# Total request body size cap, bytes.
# NETNL_MAX_BODY_BYTES=1048576

# Seconds a `reserving` row (upstream submit never completed) is allowed
# to pin a concurrency slot before `prune` clears it. Keep this short; the
# prune cron cadence bounds the real-world grace window — see
# docs/how-to/deploy-facade.md.
# NETNL_RESERVING_GRACE_SECONDS=300
